{
  "fixture_format_version": "1.0.0",
  "product": "Feed Repair Desk",
  "synthetic": true,
  "purpose": "Independent behavioral acceptance cases; adapters may map the semantics to the application schema without weakening expected outcomes.",
  "conventions": {
    "profile": "basic-product-feed-fixture-v1",
    "profile_date": "2026-09-17",
    "required_columns": [
      "id",
      "title",
      "price",
      "availability",
      "link"
    ],
    "optional_profile_columns": [
      "gtin"
    ],
    "extra_columns": "preserve without interpretation",
    "supported_dialect": "UTF-8 comma-separated CSV, header required, LF or CRLF record endings, RFC-style double-quote escaping",
    "logical_record_numbers": "one-based data records, excluding header; embedded newlines do not increment the logical record index",
    "column_indexes": "zero-based only where explicitly given; otherwise use an unambiguous header mapping",
    "all_cell_values": "strings, including IDs and GTINs; empty cell is empty string",
    "source_hash": "SHA-256 over original UTF-8 bytes including BOM and line-ending differences; no normalization before hashing",
    "availability_canonical": [
      "in_stock",
      "out_of_stock",
      "preorder",
      "backorder"
    ],
    "availability_map_required_by_fixture": {
      "In Stock": "in_stock",
      "out of stock": "out_of_stock"
    },
    "issue_codes": "semantic labels, not required implementation names; diagnostic wording may differ",
    "counts": "one row-level issue per failed profile field/rule; formula-risk is a separate export-safety rule; duplicate-ID group and affected-row counts stay distinct",
    "formula_policy": "Block CSV export for unresolved trigger-leading cells or headers. Detection ignores leading ASCII whitespace/control characters and recognizes = + - @ plus their full-width counterparts; preserve original text. This bounded policy is not a universal spreadsheet safety guarantee.",
    "ordinary_unresolved_facts": "may remain in explicitly labeled export with accompanying issue report; no rows silently removed; unresolved formula risks block CSV",
    "job_integrity": "source, profile/version, working cells, active changes, decision/undo state and exceptions must agree; source hashes are consistency checks, not signatures",
    "byte_identical_reserialization_required": false,
    "external_truth": "No live URL, inventory, GTIN ownership or merchant approval is proven by a locally passing fixture."
  },
  "cases": [
    {
